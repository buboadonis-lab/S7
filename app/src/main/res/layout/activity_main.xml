<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sector/bit-level health scan for Samsung Galaxy S7 Edge storage"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true">

            <TextView
                android:id="@+id/disclaimerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/disclaimer"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/healthText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/health_unknown"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/status_idle"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            app:indicatorColor="@color/md_theme_primary" />

        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="Scanned: 0 B\nVerified: 0 B\nRead errors: 0\nWrite errors: 0\nBad regions: 0\nSpeed: 0 B/s"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

        <!-- Single smart button: auto-detects best action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSmartScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/smart_scan"
            app:cornerRadius="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stop_scan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewResults"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/view_results" />
        </LinearLayout>

        <TextView
            android:id="@+id/batteryHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tip: Allow background activity / disable battery optimization so scanning continues with screen off."
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:visibility="gone" />

        <!-- Advanced section (collapsed by default) -->
        <TextView
            android:id="@+id/advancedToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="Advanced tools ▼"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorPrimary" />

        <LinearLayout
            android:id="@+id/advancedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Memory card manager (root) - manual overrides"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Exports a bad-blocks map from verified bad/permanent sectors. Applying tags requires root and an UNMOUNTED partition; ext2/3/4 uses e2fsck -l. This cannot safely tag sectors on mounted/active system storage."
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportBadBlocks"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/export_badblocks" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyBadBlocks"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/apply_badblocks" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewBadSegments"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/view_bad_segments" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportRecoveryScript"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_recovery_script" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_report" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/premium_mode" />

            <TextView
                android:id="@+id/premiumWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Premium mode enables advanced root actions. Never auto-apply on mounted system/data partitions. Unmounted/recovery tagging only."
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

            <LinearLayout
                android:id="@+id/premiumActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyUnmounted"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apply_unmounted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportMagiskScript"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/export_magisk_script" />
            </LinearLayout>

            <!-- Legacy buttons kept for compatibility but hidden -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanStorage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_storage"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanRaw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_raw"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRepair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/repair"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Scan log"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#11111111"
            android:fontFamily="monospace"
            android:minHeight="160dp"
            android:padding="8dp"
            android:text=""
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
